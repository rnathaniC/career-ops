# Personal data (user fills these)
cv.md
data/applications.md
data/pipeline.md
data/scan-history.tsv
reports/*.md
!reports/.gitkeep
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv
batch/tracker-additions/**/*.tsv
!batch/tracker-additions/.gitkeep
jds/*
!jds/.gitkeep

# User config and customization (never auto-updated)
config/profile.yml
portals.yml
modes/_profile.md
.update-dismissed
.update-lock

# Personal info and browser config (PII / local paths — never commit)
config/personal-info.yml
config/browser.yml

# Auto-submit output data
data/screenshots/
data/auto-submit-dry-run-*.json
data/semi-auto-*.json

# Secrets (never commit — use .env.example as template)
.env

# Live session/auth cookies — untracked but was NOT covered by any pattern above,
# so a `git add -A` could have committed live credentials. Closing that gap.
data/auth-state.json

# workday-login.mjs / linkedin-dm.mjs rebuild (2026-07-06): per-tenant Workday
# storageState (cookies/localStorage) and the LinkedIn persistent browser
# profile are live session credentials — same class of risk as auth-state.json
# above, closing the same gap for these two new session stores.
data/workday-sessions/
data/linkedin-session/
# Outreach message log (names, LinkedIn URLs, sent message text) — personal
# data, not a credential, but still shouldn't be committed.
data/linkedin-dm-log.json

# Generated
.resolved-prompt-*
node_modules/
bun.lock

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.claude/memory/
career-dashboard
package-lock.json

# Pipeline run logs
logs/
# Truncation backups + probes (see docs/RUNBOOK-large-file-edits.md)
*.bak
*.bak-*
*.bak-trunc
*.bak-trunc-*
*.pre-*
*.pretrunc-bak
_*probe*
.envrc

# ── Commit-hygiene hardening (K-2026-06-21-COMMIT) ───────────────────────────
# Rationale: a blind `git add -A` was sweeping in PII, a binary, junk, and
# dozens of ephemeral run artifacts. These rules make `add -A` safe so the
# pipeline SOURCE can be committed without dragging in noise. See the daily
# report's commit-hygiene note for the why.

# Dated/ephemeral run artifacts — regenerated every refresh, never source-of-truth
data/airtable-payload-*.json
data/graded-jobs-*.json
data/kanban-import-*.json
data/readiness-results-*.json
data/inject-run-*.json
data/archive-run-*.json
data/referral-queue-*.json
data/workday-jobs.json
data/board-state.json
data/board-state.json.tmp
data/cadence-status.json
data/last-refresh.json
data/airtable-sync-state.json

# PII — personal contact / network data (note: the .yml rule above missed the
# .txt variant; this catches every form)
config/personal-info.yml*
config/linkedin-connections.json

# Compiled binaries — build outputs, never commit
*.exe
*.dll
*.so

# Stray junk / temp
New Text Document*.txt
_cleared-update-lock.*
*.tmp

# ── Round 2 hardening (after 9adbc09 swept in scratch; tidy-repo.bat untracks) ─
# Cloudflare worker local dev — secrets template + build cache (never commit)
cloudflare-worker/.dev.vars
cloudflare-worker/.wrangler/
# This helper's own log
commit-pulse.log
# Root + data scratch / scan caches / state dumps — all regenerated
tmp/
data/tmp/
data/tmp-*
data/test-*
data/live-*
data/worker-raw/
data/worker-raw-*/
data/worker-candidates-*
data/worker-new-us-*
data/worker-scan-*
data/kanban-snapshot-*
data/kanban-k2-export-*
data/secondary-verified-*
data/dead-listings-*
data/*.err
# Trash/probe leftovers
modes/_zztest/
*.trash.*

# self-healing preflight lib cache (Kaizen K-0626-1)
data/.preflight-libs/
.agents/scratch/
.fuse_hidden*
config/referral-relationships.yml
config/linkedin-connections.backup-*.json
data/Connections.csv
