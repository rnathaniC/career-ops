{
  "source": "Harvard MCS Resumes & Cover Letters Guide (2023)",
  "resume": {
    "language": {
      "no_personal_pronouns": ["I", "me", "my", "mine", "myself", "we", "our"],
      "must_start_bullets_with_action_verb": true,
      "no_narrative_style": true,
      "quantification_required": true,
      "no_abbreviations_informal": true
    },
    "structure": {
      "required_sections": ["Education", "Experience"],
      "reverse_chronological": true,
      "consistent_format": true,
      "no_lines_starting_with_date": true,
      "must_have_email": true,
      "must_have_phone": true,
      "max_pages": 2
    },
    "top_mistakes_to_flag": [
      "missing_email_or_phone",
      "passive_language",
      "no_quantification",
      "too_long"
    ],
    "ats": {
      "keyword_overlap_min_pct": 30,
      "no_tables": true,
      "standard_section_headers": true
    }
  },
  "cover_letter": {
    "structure": {
      "has_date": true,
      "has_addressee": true,
      "has_company_name": true,
      "colon_after_salutation": true,
      "three_paragraph_minimum": true,
      "max_pages": 1,
      "opening_states_position": true,
      "closing_thanks_reader": true
    },
    "language": {
      "no_overuse_of_I": true,
      "i_frequency_max_pct": 12,
      "uses_action_verbs": true,
      "references_company_specifically": true,
      "references_jd_keywords": true
    },
    "cleanpaste_required": true
  },
  "action_verbs": [
    "Accomplished","Achieved","Administered","Analyzed","Assigned","Attained","Chaired","Consolidated","Contracted","Coordinated","Delegated","Developed","Directed","Earned","Evaluated","Executed","Handled","Headed","Impacted","Improved","Increased","Led","Mastered","Orchestrated","Organized","Oversaw","Planned","Predicted","Prioritized","Produced","Proved","Recommended","Regulated","Reorganized","Reviewed","Scheduled","Spearheaded","Strengthened","Supervised","Surpassed",
