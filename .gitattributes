# Normalize line endings: stop OneDrive/Windows checkout from rewriting every
# file to CRLF and burying real diffs under whole-tree churn.
# Default: treat as text, store + check out as LF.
* text=auto eol=lf

# Windows-native scripts must keep CRLF to run correctly on the host.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary / non-diffable assets — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.zip   binary
