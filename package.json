{
  "name": "career-ops",
  "version": "1.12.0",
  "description": "AI-powered job search pipeline — works with any AI coding CLI (Claude Code, OpenCode, Gemini, Codex, Qwen)",
  "private": true,
  "scripts": {
    "test": "node test-all.mjs",
    "doctor": "node doctor.mjs",
    "pdf": "node generate-pdf.mjs",
    "test:unit": "node --test \"test/*.test.mjs\"",
    "verify": "node verify-pipeline.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "sync-check": "node cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update:test": "node updater-migration-tests.mjs",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node check-liveness.mjs",
    "scan": "node scan.mjs",
    "patterns": "node analyze-patterns.mjs",
    "gemini:eval": "node gemini-eval.mjs",
    "postinstall": "npx playwright install chromium --with-deps || npx playwright install chromium --with-deps",
    "fix-nul": "node scripts/fix-nul-bytes.mjs",
    "airtable:pull": "node scripts/airtable-sync.mjs --pull",
    "airtable:push": "node scripts/airtable-sync.mjs --push",
    "archive:apply": "node scripts/archive-stale.mjs --apply",
    "workday": "node scripts/workday-stub.mjs",
    "worker-grader": "node scripts/worker-grader.mjs",
    "indeed:resolve": "node scripts/indeed-resolve.mjs",
    "indeed:enrich": "node scripts/indeed-enrich.mjs --apply",
    "indeed:scan": "node scripts/indeed-enrich.mjs --scan",
    "kanban:inject:apply": "node scripts/kanban-inject.mjs",
    "board-state": "node scripts/export-board-state.mjs",
    "ingest": "node scripts/ingest-runner.mjs",
    "referral-queue": "node scripts/referral-queue.mjs",
    "score:dry-run": "node scripts/readiness-scorer.mjs --dry-run",
    "auto-submit:live": "node scripts/auto-submit.mjs --kanban-json data/board-state.json --live --allow-tier lower",
    "auto-submit:park": "node scripts/auto-submit.mjs --kanban-json data/board-state.json --park-ready",
    "export-auth": "node scripts/export-auth-state.mjs",
    "ingest:dry": "node scripts/ingest-runner.mjs --dry-run",
    "auto-submit": "node scripts/auto-submit.mjs --kanban dashboard/job-pulse-kanban.html",
    "check-liveness": "node scripts/check-job-liveness.mjs",
    "safe-edit": "node scripts/safe-edit.mjs",
    "codegen:states": "node scripts/codegen-states.mjs",
    "cl:all": "node scripts/generate-cl.mjs --all",
    "cadence": "node scripts/cadence-watchdog.mjs",
    "connections:sync": "node scripts/sync-connections.mjs",
    "pulse:refresh": "node scripts/pulse-refresh.mjs",
    "pulse:daily-report": "node scripts/daily-health-report.mjs",
    "board:snapshot": "node scripts/render-board-snapshot.mjs",
    "email:report": "node scripts/email-report.mjs",
    "cadence:mark": "node scripts/cadence-mark.mjs",
    "workday:login": "node scripts/workday-login.mjs",
    "workday:sessions": "node scripts/workday-login.mjs --list",
    "linkedin:list": "node scripts/linkedin-dm.mjs --list",
    "submit-ready": "node scripts/open-submit-ready.mjs",
    "submit-ready:open": "node scripts/open-submit-ready.mjs --open",
    "commute:sweep": "node scripts/commute-sweep.mjs",
    "commute:sweep:apply": "node scripts/commute-sweep.mjs --lanes \"Submit Ready\" --apply",
    "flags:scan": "node scripts/scan-card-flags.mjs",
    "pulse:scripts:save": "node scripts/restore-pulse-scripts.mjs --save",
    "pulse:scripts:restore": "node scripts/restore-pulse-scripts.mjs --restore"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "opencode",
    "career",
    "career-ops",
    "careerops",
    "automation"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://santifer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/santifer/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.0.0",
    "js-yaml": "^4.1.1",
    "nodemailer": "^6.9.14",
    "playwright": "1.61.0"
  }
}
